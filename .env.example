# Caminho completo ao tesseract.exe no Windows, se não estiver no PATH
# PDF2WORD_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# PDF2WORD_POPPLER_PATH=C:\Program Files\poppler\Library\bin

PDF2WORD_DEFAULT_OCR_LANG=por+eng
PDF2WORD_OCR_DPI=300
PDF2WORD_MIN_TEXT_CHARS_PER_PAGE=40
PDF2WORD_MAX_UPLOAD_MB=50
